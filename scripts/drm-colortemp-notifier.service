[Unit]
Description=DRM Color Temperature Notification Service
Documentation=man:drm_colortemp(1)
After=graphical.target

[Service]
Type=simple
# Only run when notifications are enabled. Otherwise the unit is skipped
# ("condition failed") instead of starting, exiting and being restarted forever.
ExecCondition=/bin/sh -c '. /etc/default/drm-colortemp.conf && [ "$$NOTIFY_ENABLED" = 1 ]'
ExecStart=/usr/local/bin/drm-colortemp-notifier.sh
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

# Run as root (needs to switch to user context for notifications)
User=root

[Install]
WantedBy=graphical.target
